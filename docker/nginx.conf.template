# `user` directive intentionally omitted: the master process already runs as
# the `nginx` user (set via USER in the Dockerfile's connect stage). Leaving
# `user nginx;` in place would be a no-op when non-root and emits a warning.
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml+rss image/avif application/wasm application/octet-stream;
    # .gz siblings of wasm/data come from ph connect build; nginx:alpine lacks brotli.
    gzip_static on;

    # Reactor worker files are content-addressed only when the app asks for them with ?v=.
    map $arg_v $ph_worker_cache_control {
        ""      "no-cache";
        default "public, max-age=31536000, immutable";
    }

    server {
        listen 0.0.0.0:${PORT};
        server_name _;
        root /var/www/html/project;
        # Relative Location headers, so redirects survive a proxy on another host/port.
        absolute_redirect off;

        ${PH_CONNECT_BASE_REDIRECT}

        location /health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 'OK';
        }

        # `^~` stops the regex location below from being checked for these
        # prefixes: nginx gives regex locations precedence over plain prefix
        # matches, so without it the root-files regex would capture
        # /assets/<file>.js and alias it to the project root -> 404.
        location ^~ ${PH_CONNECT_BASE_PREFIX}/assets/ {
            alias /var/www/html/project/assets/;
            access_log off;
            log_not_found off;
            etag off;
            expires max;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        location ^~ ${PH_CONNECT_BASE_PREFIX}/fonts/ {
            alias /var/www/html/project/fonts/;
            access_log off;
            log_not_found off;
            expires max;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # Shared-dependency vendor and self-hosted React: content-hashed file
        # names, so every build's import map points at new URLs.
        location ^~ ${PH_CONNECT_BASE_PREFIX}/__vendor__/ {
            alias /var/www/html/project/__vendor__/;
            access_log off;
            log_not_found off;
            etag off;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # The stable-named copies (dev fallback, build metadata) must revalidate.
        location = ${PH_CONNECT_BASE_PREFIX}/__vendor__/shared-deps.js {
            alias /var/www/html/project/__vendor__/shared-deps.js;
            access_log off;
            add_header Cache-Control "no-cache" always;
        }

        location = ${PH_CONNECT_BASE_PREFIX}/__vendor__/import-map.json {
            alias /var/www/html/project/__vendor__/import-map.json;
            access_log off;
            add_header Cache-Control "no-cache" always;
        }

        location ^~ ${PH_CONNECT_BASE_PREFIX}/__react__/ {
            alias /var/www/html/project/__react__/;
            access_log off;
            log_not_found off;
            etag off;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # The worker's emitted assets (PGlite wasm/data) carry hashed names.
        location ^~ ${PH_CONNECT_BASE_PREFIX}/__reactor_worker__/assets/ {
            alias /var/www/html/project/__reactor_worker__/assets/;
            access_log off;
            log_not_found off;
            etag off;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        location ^~ ${PH_CONNECT_BASE_PREFIX}/__reactor_worker__/ {
            alias /var/www/html/project/__reactor_worker__/;
            access_log off;
            log_not_found off;
            add_header Cache-Control $ph_worker_cache_control;
        }

        # The dynamic manifest route lives in the service worker; this is the static fallback.
        location = ${PH_CONNECT_BASE_PREFIX}/manifest.webmanifest {
            alias /var/www/html/project/manifest.webmanifest;
            access_log off;
            types { }
            default_type application/manifest+json;
            add_header Cache-Control "no-cache" always;
        }

        location = ${PH_CONNECT_BASE_PREFIX}/service-worker.js {
            alias /var/www/html/project/service-worker.js;

            access_log off;
            log_not_found off;
            etag off;

            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        # Operator-mutable runtime config: force revalidation on every load
        # so post-deploy edits are visible immediately, but allow ETag-based
        # 304s when the file is unchanged (saves the body transfer).
        location = ${PH_CONNECT_BASE_PREFIX}/powerhouse.config.json {
            alias /var/www/html/project/powerhouse.config.json;
            access_log off;
            log_not_found off;
            add_header Cache-Control "no-cache" always;
        }

        # Build identity emitted at build time (build-hash.json): the SPA
        # compares it to its baked-in hash to detect a new deploy on the
        # server. MUST revalidate on every load or the check goes blind.
        location = ${PH_CONNECT_BASE_PREFIX}/build-hash.json {
            alias /var/www/html/project/build-hash.json;
            access_log off;
            log_not_found off;
            add_header Cache-Control "no-cache" always;
        }

        # Root-level static files (icon.ico, manifest, ...). Must be anchored
        # with `^`: at the default `/` base path PH_CONNECT_BASE_PREFIX is
        # empty, and an unanchored `/<file>.<ext>$` matches the tail of ANY
        # file URI (e.g. /assets/index-*.js), hijacking it from the prefix
        # locations above and 404ing on the wrong alias path.
        location ~ ^${PH_CONNECT_BASE_PREFIX}/(?!index\.html$)([^/]+\.[a-z0-9]+)$ {
            alias /var/www/html/project/$1;
            access_log off;
            log_not_found off;
            etag on;
            add_header Cache-Control "public, must-revalidate";
        }

        location ${PH_CONNECT_BASE_PATH} {
            try_files $uri $uri/ /index.html;
        }
    }
}
