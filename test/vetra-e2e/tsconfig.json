{
  "extends": "../../tsconfig.options.json",
  "compilerOptions": {
    "outDir": "./.tsbuild",
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "paths": {
      "document-models": ["./document-models/index.ts"],
      "document-models/*": ["./document-models/*/index.ts"],
      "editors": ["./editors/index.ts"],
      "editors/*": ["./editors/*/index.ts"],
      "processors": ["./processors/index.ts"],
      "processors/*": ["./processors/*/index.ts"],
      "subgraphs": ["./subgraphs/index.ts"],
      "subgraphs/*": ["./subgraphs/*/index.ts"]
    }
  },
  "references": [
    {
      "path": "../../apps/connect"
    },
    {
      "path": "../../apps/switchboard"
    },
    {
      "path": "../../clis/ph-cli"
    },
    {
      "path": "../../packages/clint"
    },
    {
      "path": "../../packages/design-system"
    },
    {
      "path": "../../packages/desktop"
    },
    {
      "path": "../../packages/document-model"
    },
    {
      "path": "../../packages/host-core"
    },
    {
      "path": "../../packages/reactor-browser"
    },
    {
      "path": "../../packages/registry"
    },
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/vetra"
    },
    {
      "path": "../../packages/vetra-studio"
    },
    {
      "path": "../e2e-utils"
    },
    {
      "path": "../versioned-documents"
    }
  ],
  "include": ["**/*", "powerhouse.manifest.json"],
  // hosts/connect/routes/ type-checks against .ph/connect-routes.gen.ts, which a build writes.
  "exclude": [
    "dist",
    "node_modules",
    ".ph",
    "hosts/connect/routes",
    // tsc -p hosts checks it against the built packages; here it would pull their sources in
    "hosts/types.d.ts"
  ]
}
