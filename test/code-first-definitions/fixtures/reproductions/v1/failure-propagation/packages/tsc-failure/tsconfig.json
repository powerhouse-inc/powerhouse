{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*.ts"]
}
