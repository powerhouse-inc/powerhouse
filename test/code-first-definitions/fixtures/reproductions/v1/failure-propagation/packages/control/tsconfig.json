{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "dist/types",
    "rootDir": ".",
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "include": ["index.ts", "definition.ts"]
}
