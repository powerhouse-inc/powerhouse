{
  "name": "@powerhousedao/e2e-utils",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./helpers": {
      "source": "./src/helpers/index.ts",
      "types": "./dist/helpers/index.d.mts",
      "import": "./dist/helpers/index.mjs"
    },
    "./helpers/*": {
      "source": "./src/helpers/*.ts",
      "import": "./dist/helpers/*.mjs"
    },
    "./types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/index.d.mts",
      "import": "./dist/types/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc",
    "lint": "cd ../.. && oxlint test/e2e-utils",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "@playwright/test": "npm:flashwright-test@1.64.1-flashwright.11"
  },
  "devDependencies": {
    "@playwright/test": "npm:flashwright-test@1.64.1-flashwright.11",
    "@powerhousedao/shared": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {}
}
