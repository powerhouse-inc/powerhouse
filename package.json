{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "tsc": "tsc --build",
    "test": "pnpm test:ci",
    "test:ci": "cross-env CI=true pnpm --filter=document-model --filter=@powerhousedao/codegen --filter=@powerhousedao/shared --filter=@powerhousedao/pglite-fs --filter=@powerhousedao/pieces-framework --filter=@powerhousedao/registry --filter=@powerhousedao/reactor-api --filter=@powerhousedao/reactor-browser --filter=@powerhousedao/reactor-hypercore --filter=@powerhousedao/reactor-group --filter=@powerhousedao/reactor-mcp --filter=@powerhousedao/vetra --filter=@powerhousedao/workflow --filter=@powerhousedao/reactor-workflow --filter=@powerhousedao/versioned-documents --filter=@powerhousedao/switchboard --filter=@powerhousedao/connect --filter=@powerhousedao/design-system --filter=@powerhousedao/analytics-engine-core --filter=@powerhousedao/analytics-engine-graphql --filter=@powerhousedao/analytics-engine-knex --filter=@powerhousedao/load-test-connect --filter=@powerhousedao/ph-cli --filter=ph-cmd --filter=@renown/sdk --filter=@powerhousedao/powerhouse-vetra-packages --no-bail run test",
    "test:ci:platform": "cross-env CI=true pnpm --filter=@powerhousedao/codegen --filter=@powerhousedao/pglite-fs --filter=@powerhousedao/registry --filter=@powerhousedao/reactor-api --filter=@powerhousedao/reactor-mcp --filter=@powerhousedao/reactor-workflow --filter=@powerhousedao/versioned-documents --filter=@powerhousedao/switchboard --filter=@powerhousedao/connect --filter=@powerhousedao/load-test-connect --filter=@powerhousedao/ph-cli --filter=ph-cmd --filter=@renown/sdk --no-bail run test",
    "test:codegen": "pnpm --filter=test-codegen run test",
    "test:e2e:vetra": "pnpm --filter=test-package-vetra run test",
    "test:e2e:vetra:worker": "pnpm --filter=test-package-vetra run test:worker",
    "test:e2e:package": "pnpm --filter=test-package-e2e run test",
    "test:e2e:workflow-piece": "pnpm --filter=test-workflow-piece-e2e run test",
    "test:e2e:recipes": "pnpm --filter=test-recipes-e2e run recipes",
    "doc-harness": "pnpm --filter=doc-harness run cli --",
    "test:integration:analytics": "pnpm --filter=@powerhousedao/analytics-engine-browser run test",
    "test:e2e:switchboard": "pnpm --filter=@powerhousedao/test-switchboard run test",
    "test:reactor": "pnpm --filter=@powerhousedao/reactor run test",
    "test:reactor-packages": "pnpm --filter=@powerhousedao/reactor-drive --filter=@powerhousedao/reactor-attachments --no-bail run test",
    "test:integration": "pnpm --filter=@powerhousedao/load-test-connect run test:integration && pnpm --filter=@powerhousedao/reactor-api run test:integration",
    "test:browser": "pnpm --filter=@powerhousedao/reactor-browser run test",
    "test:pg": "pnpm --filter=@powerhousedao/analytics-engine-pg run test",
    "test:coverage": "pnpm vitest run --coverage",
    "simulate-ci-workflow": "pnpm clean && pnpm install-ci && pnpm check-ts-references && pnpm build && pnpm typecheck && pnpm typecheck:consumers && pnpm rebuild --recursive && pnpm --filter=@powerhousedao/versioned-documents --no-bail run build && pnpm lint && pnpm test:ci && pnpm test:codegen && pnpm test:e2e:vetra && pnpm test:e2e:package && pnpm test:e2e:workflow-piece && pnpm build:storybook && pnpm check-circular-imports",
    "simulate-ci-workflow-reactor": "pnpm simulate-ci-workflow && pnpm test:reactor && pnpm test:integration",
    "lint": "pnpm -r --workspace-concurrency=1 lint && pnpm format:check",
    "lint:fix": "pnpm -r --workspace-concurrency=1 lint --fix && pnpm format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "install-ci": "pnpm i --frozen-lockfile",
    "academy:install": "pnpm --dir apps/academy install --frozen-lockfile",
    "academy:dev": "pnpm --dir apps/academy dev",
    "academy:build": "pnpm --dir apps/academy build",
    "build": "pnpm --filter=@powerhousedao/config --filter=@powerhousedao/pieces-framework --filter=@renown/sdk --filter=@powerhousedao/common --filter=@powerhousedao/builder-tools --filter=@powerhousedao/codegen --filter=document-model --filter=@powerhousedao/design-system --filter=@powerhousedao/powerhouse-vetra-packages --filter=@powerhousedao/pglite-fs --filter=@powerhousedao/reactor-api --filter=@powerhousedao/reactor-attachments --filter=@powerhousedao/reactor-browser --filter=@powerhousedao/reactor --filter=@powerhousedao/reactor-drive --filter=@powerhousedao/reactor-group --filter=@powerhousedao/reactor-hypercore --filter=@powerhousedao/reactor-mcp --filter=@powerhousedao/opentelemetry-instrumentation-reactor --filter=@powerhousedao/registry --filter=@powerhousedao/shared --filter=@powerhousedao/vetra --filter=@powerhousedao/workflow --filter=@powerhousedao/reactor-workflow --filter=@powerhousedao/analytics-engine-browser --filter=@powerhousedao/analytics-engine-core --filter=@powerhousedao/analytics-engine-graphql --filter=@powerhousedao/analytics-engine-knex --filter=@powerhousedao/analytics-engine-pg --filter=@powerhousedao/connect --filter=@powerhousedao/switchboard --filter=@powerhousedao/ph-cli --filter=ph-cmd --filter=@powerhousedao/load-test-client --filter=@powerhousedao/load-test-connect --filter=@powerhousedao/e2e-utils --no-bail run build",
    "typecheck": "tsc --build",
    "typecheck:consumers": "tsc --build test/test-consumer-project",
    "build:storybook": "pnpm --filter=@powerhousedao/design-system run build:storybook",
    "clean": "bun x git clean -fdX",
    "run-release": "bun run releases/patch-nx-publish.ts && bun run releases/release.ts",
    "run-release-safe": "pnpm run-release --verbose --skip-publish --skip-changelog --skip-push",
    "release-wizard": "tsx scripts/release/index.ts",
    "prepare": "husky",
    "check-circular-imports": "dpdm -T ./**/* --no-tree --no-warning --exit-code circular:1",
    "check-ts-references": "pnpm update-ts-references --check",
    "knip": "knip",
    "postinstall": "pnpm update-ts-references",
    "audit:download": "tsx tools/registry-audit/download.ts",
    "audit:extract": "tsx tools/registry-audit/extract.ts",
    "audit:analyze": "tsx tools/registry-audit/analyze.ts",
    "audit:typecheck": "tsx tools/registry-audit/typecheck.ts",
    "audit:load": "tsx tools/registry-audit/load.ts",
    "audit:create-query": "tsx tools/registry-audit/create-query.ts"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,yml,yaml,toml,graphql,gql,html,vue,css,scss,less}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nx/devkit": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/plugin": "^22.7.1",
    "@oxlint/plugins": "1.83.0",
    "@powerhousedao/builder-tools": "workspace:*",
    "@powerhousedao/ph-cli": "workspace:*",
    "@powerhousedao/reactor-browser": "workspace:*",
    "@powerhousedao/renown-package": "2.0.0-dev.0",
    "@powerhousedao/shared": "workspace:*",
    "@swc-node/register": "~1.10.9",
    "@swc/core": "~1.11.1",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.0",
    "@types/yargs": "^17.0.33",
    "cross-env": "catalog:",
    "document-model": "workspace:*",
    "dpdm": "^4.2.0",
    "eslint-plugin-better-tailwindcss": "4.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.4",
    "husky": "^9.1.7",
    "knip": "catalog:",
    "lint-staged": "^17.2.0",
    "nx": "22.7.1",
    "oxfmt": "catalog:",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "catalog:",
    "read-pkg": "catalog:",
    "remeda": "catalog:",
    "rimraf": "^6.0.1",
    "semver": "catalog:",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "update-ts-references": "^6.0.0",
    "vitest": "catalog:",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "@powerhousedao/connect": "workspace:*",
    "fast-glob": "^3.3.3"
  },
  "engines": {
    "node": ">=24"
  },
  "commitlint": {
    "rules": {
      "header-max-length": [
        2,
        "always",
        200
      ],
      "subject-case": [
        2,
        "never",
        [
          "sentence-case",
          "start-case",
          "pascal-case"
        ]
      ]
    }
  }
}
