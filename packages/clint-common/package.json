{
  "name": "@powerhousedao/clint-common",
  "version": "6.3.0-dev.6",
  "description": "The chat-session document model and editor, and the chat module that runs agent turns from chat-session documents for a clint CLI (watch trigger, stream bridge, steer processor).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-inc/powerhouse",
    "directory": "packages/clint-common"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.mjs"
    },
    "./document-models": {
      "source": "./document-models/index.ts",
      "types": "./dist/types/document-models/index.d.ts",
      "browser": "./dist/browser/document-models/index.js",
      "node": "./dist/node/document-models/index.mjs"
    },
    "./document-models/*": {
      "source": "./document-models/*/index.ts",
      "types": "./dist/types/document-models/*/index.d.ts",
      "browser": "./dist/browser/document-models/*/index.js",
      "node": "./dist/node/document-models/*/index.mjs"
    },
    "./editors": {
      "source": "./editors/index.ts",
      "types": "./dist/types/editors/index.d.ts",
      "browser": "./dist/browser/editors/index.js",
      "node": "./dist/node/editors/index.mjs"
    },
    "./editors/*": {
      "source": "./editors/*/module.ts",
      "types": "./dist/types/editors/*/module.d.ts",
      "browser": "./dist/browser/editors/*/module.js"
    },
    "./subgraphs": {
      "source": "./subgraphs/index.ts",
      "types": "./dist/types/subgraphs/index.d.ts",
      "node": "./dist/node/subgraphs/index.mjs"
    },
    "./processors": {
      "source": "./processors/index.ts",
      "types": "./dist/types/processors/index.d.ts",
      "browser": "./dist/browser/processors/index.js",
      "node": "./dist/node/processors/index.mjs"
    },
    "./chat": {
      "source": "./chat/index.ts",
      "types": "./dist/types/chat/index.d.ts",
      "import": "./dist/node/chat/index.mjs"
    },
    "./manifest": "./dist/powerhouse.manifest.json",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tsc": "tsc",
    "lint": "cd ../.. && oxlint packages/clint-common",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "build": "tsx ./build.ts",
    "generate": "ph-cli generate"
  },
  "peerDependencies": {
    "@powerhousedao/clint": "workspace:*",
    "@powerhousedao/reactor-browser": "workspace:*",
    "document-model": "workspace:*",
    "graphql": "^16",
    "graphql-tag": "^2",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@powerhousedao/clint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@powerhousedao/clint": "workspace:*",
    "@powerhousedao/design-system": "workspace:*",
    "@powerhousedao/reactor": "workspace:*",
    "@powerhousedao/reactor-attachments": "workspace:*",
    "@powerhousedao/reactor-browser": "workspace:*",
    "@powerhousedao/shared": "workspace:*",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ai": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "document-model": "workspace:*",
    "graphql": "catalog:",
    "graphql-tag": "catalog:",
    "jsdom": "24.1.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.11",
    "radix-ui": "^1.4.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "use-stick-to-bottom": "^1.1.4",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
