{
  "name": "@powerhousedao/reactor",
  "version": "6.2.2-dev.70",
  "description": "Core Powerhouse reactor \u2014 stores documents, resolves conflicts, and reprocesses operation histories. Supports local, cloud, and decentralized storage backends.",
  "repository": {
    "url": "https://github.com/powerhouse-inc/powerhouse",
    "directory": "packages/reactor",
    "type": "git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage --printConsoleTrace=true --silent=false",
    "test:watch": "vitest --coverage",
    "lint": "eslint",
    "bench": "vitest bench --run",
    "bench:record": "tsx bench/records/run-record-all.ts",
    "bench:auth": "vitest bench --run bench/auth-scope",
    "bench:auth:record": "vitest bench --run bench/auth-scope --outputJson bench/results/auth-scope.json",
    "bench:auth:compare": "vitest bench --run bench/auth-scope --compare bench/results/auth-scope.json",
    "bench:events:record": "vitest bench --run bench/event-bus --outputJson bench/results/event-bus.json",
    "bench:queue:record": "vitest bench --run bench/queue-perf --outputJson bench/results/queue-perf.json",
    "bench:queue-only:record": "vitest bench --run bench/queue-only --outputJson bench/results/queue-only.json",
    "bench:cache:record": "vitest bench --run bench/write-cache --outputJson bench/results/write-cache.json",
    "bench:sync": "node --import tsx bench/two-reactor-sync.ts",
    "bench:sync:record": "node --import tsx bench/two-reactor-sync.ts --record",
    "bench:sync:smoke": "node --import tsx bench/two-reactor-sync.ts --smoke",
    "clean": "rimraf dist",
    "clean:node_modules": "rimraf node_modules",
    "claude": "pnpm build && pnpm test && pnpm exec prettier --write \"**/*.ts\" && pnpm lint",
    "migrate": "tsx src/storage/migrations/run-migrations.ts",
    "migrate:status": "tsx src/storage/migrations/run-migrations.ts status",
    "preflight:auth": "tsx src/admin/run-stream-order-check.ts",
    "bench:records": "tsx bench/records/run-records.ts",
    "bench:records:verify": "tsx bench/records/run-records.ts verify",
    "bench:records:from-vitest": "tsx bench/records/run-from-vitest.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "powerhouse",
    "vetra",
    "document-model",
    "local-first",
    "event-sourcing",
    "reactor",
    "cqrs",
    "decentralized",
    "sync"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "uuid": "^14.0.0",
    "kysely": "catalog:",
    "kysely-pglite-dialect": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "pg": "catalog:",
    "@sindresorhus/fnv1a": "catalog:",
    "@powerhousedao/shared": "workspace:*",
    "document-model": "workspace:*"
  },
  "devDependencies": {
    "@powerhousedao/pglite-fs": "workspace:*",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "catalog:",
    "tinybench": "^2.9.0",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "zod": "catalog:"
  },
  "homepage": "https://academy.vetra.io/academy/Reference/Reactor/WorkingWithTheReactor"
}
