{
  "name": "@powerhousedao/pieces-framework",
  "version": "6.2.3-dev.84",
  "description": "Powerhouse's published copy of the Activepieces piece framework, widened with the reactor context.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-inc/powerhouse",
    "directory": "packages/pieces-framework"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./common": {
      "source": "./src/common.ts",
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js"
    },
    "./host": {
      "source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./block-type": {
      "source": "./src/block-type.ts",
      "types": "./dist/block-type.d.ts",
      "import": "./dist/block-type.js"
    },
    "./workflow": {
      "source": "./src/workflow.ts",
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tsc": "tsc",
    "lint": "cd ../.. && oxlint packages/pieces-framework",
    "test": "vitest --run",
    "build": "tsdown",
    "sync-upstream": "tsx scripts/sync-upstream.mts"
  },
  "upstream": {
    "repository": "https://github.com/activepieces/activepieces",
    "tag": "0.92.3",
    "commit": "2fc7f8dcaa84400f9db53fb0de7fc4340d055c62",
    "packages": {
      "@activepieces/pieces-framework": "0.40.0",
      "@activepieces/pieces-common": "0.14.0",
      "@activepieces/core-piece-types": "0.11.1",
      "@activepieces/core-utils": "0.8.1",
      "@activepieces/engine": "0.7.0"
    }
  },
  "dependencies": {
    "dayjs": "1.11.9",
    "form-data": "4.0.6",
    "ipaddr.js": "2.3.0",
    "nanoid": "3.3.17",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@powerhousedao/reactor": "workspace:*",
    "@powerhousedao/shared": "workspace:*",
    "@types/node": "catalog:",
    "deepmerge-ts": "7.1.0",
    "prettier": "catalog:",
    "ts-morph": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@powerhousedao/reactor": "workspace:*",
    "@powerhousedao/shared": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@powerhousedao/reactor": {
      "optional": true
    },
    "@powerhousedao/shared": {
      "optional": true
    }
  }
}
