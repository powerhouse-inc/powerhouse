    "instance": {
      "additionalProperties": false,
      "description": "Per-instance identity. Lets one origin host multiple isolated Connect instances, each with its own storage + SharedWorker namespace.",
      "properties": {
        "multiReactor": {
          "default": false,
          "description": "Opt-in multi-reactor routing. When on, Connect routes through the in-browser reactor plus remote backends instead of the single in-browser reactor. Off by default; the single-reactor path is unchanged.",
          "type": "boolean",
        },
        "namespace": {
          "default": null,
          "description": "Explicit storage/SharedWorker namespace for this instance. \`null\` derives it from the base path (and, later, the configured endpoint), so root deployments stay byte-identical.",
          "type": [
            "string",
            "null",
          ],
        },
        "reactorWorker": {
          "default": false,
          "description": "Host the reactor in a shared worker instead of on the main thread. Off by default; the main-thread reactor stays the proven path until cutover is verified. Packaged deployments load the worker from the prebuilt bundle \`ph connect build\` emits under __reactor_worker__/ (the dev server builds it lazily at the same path); when that bundle is absent the feature reports itself unavailable instead of starting a worker that cannot load.",
          "type": "boolean",
        },
      },
      "required": [
        "namespace",
        "reactorWorker",
      ],
      "type": "object",
    },
    "openPanel": {
