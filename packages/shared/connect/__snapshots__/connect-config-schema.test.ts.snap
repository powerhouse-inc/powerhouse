            "launch_handler": {
              "additionalProperties": false,
              "description": "How the OS launches the app for handled files/links. Connect defaults to focus-existing.",
              "properties": {
                "client_mode": {
                  "enum": [
                    "auto",
                    "focus-existing",
                    "navigate-existing",
                    "navigate-new",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "client_mode",
              ],
              "type": "object",
            },
            "name": {
              "type": "string",
            },
            "scope": {
              "type": "string",
            },
            "short_name": {
              "type": "string",
            },
            "start_url": {
              "type": "string",
            },
            "theme_color": {
              "type": "string",
            },
          },
          "type": "object",
        },
        "maximumFileSizeToCacheInBytes": {
          "description": "Raise the precache file-size ceiling. The max across all contributors wins, so no contributor can shrink another's limit.",
          "type": "number",
        },
        "navigateFallbackDenylist": {
          "description": "Extra SPA navigate-fallback denylist patterns, unioned with the built-ins.",
          "items": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "flags": {
                    "description": "RegExp flags (e.g. 'i').",
                    "type": "string",
                  },
                  "source": {
                    "description": "RegExp source.",
                    "type": "string",
                  },
                },
                "required": [
                  "source",
                ],
                "type": "object",
              },
            ],
            "description": "URL match. A string is matched verbatim by Workbox; { source, flags } is rebuilt into a RegExp at build time.",
          },
          "type": "array",
        },
        "runtimeCaching": {
          "description": "Runtime-caching rules appended after the built-in rules. Workbox is first-match-wins, so these cannot override a built-in rule matching the same URL.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "handler": {
                "enum": [
                  "CacheFirst",
                  "CacheOnly",
                  "NetworkFirst",
                  "NetworkOnly",
                  "StaleWhileRevalidate",
                ],
                "type": "string",
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "DELETE",
                  "HEAD",
                  "PATCH",
                ],
                "type": "string",
              },
              "options": {
                "additionalProperties": false,
                "properties": {
                  "cacheName": {
                    "type": "string",
                  },
                  "cacheableResponse": {
                    "additionalProperties": false,
                    "properties": {
                      "headers": {
                        "additionalProperties": {
                          "type": "string",
                        },
                        "propertyNames": {
                          "type": "string",
                        },
                        "type": "object",
                      },
                      "statuses": {
                        "items": {
                          "type": "number",
                        },
                        "type": "array",
                      },
                    },
                    "type": "object",
                  },
                  "expiration": {
                    "additionalProperties": false,
                    "properties": {
                      "maxAgeSeconds": {
                        "type": "number",
                      },
                      "maxEntries": {
                        "type": "number",
                      },
                    },
                    "type": "object",
                  },
                  "networkTimeoutSeconds": {
                    "description": "Seconds a NetworkFirst rule waits for the network before falling back to the cache.",
                    "type": "number",
                  },
                },
                "type": "object",
              },
              "urlPattern": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "flags": {
                        "description": "RegExp flags (e.g. 'i').",
                        "type": "string",
                      },
                      "source": {
                        "description": "RegExp source.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "source",
                    ],
                    "type": "object",
                  },
                ],
                "description": "URL match. A string is matched verbatim by Workbox; { source, flags } is rebuilt into a RegExp at build time.",
              },
            },
            "required": [
              "urlPattern",
              "handler",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
    "reactor": {
      "additionalProperties": false,
      "description": "Settings for the reactor Connect runs in the browser, on the main thread or in the shared worker alike.",
      "properties": {
        "createSignaturePolicy": {
          "default": "v2-required",
          "description": "What new documents are created as. \`v2-required\` documents accept only v2 action signatures and take content-addressed ids; set \`legacy\` while any peer Connect syncs with predates them. Existing documents keep their policy.",
          "enum": [
            "legacy",
            "v2-required",
          ],
          "type": "string",
        },
        "featureFlags": {
          "additionalProperties": false,
          "description": "Enforcement flags. Each implies its predecessors, and the reactor refuses to boot on a set that names a later flag without an earlier one. These are consensus settings: a Connect syncing with a fleet must carry the same flags the fleet does, or the two reach different replay outcomes for the same history and diverge.",
          "properties": {
            "authConditions": {
              "default": false,
              "description": "Evaluate \`where\` and \`match\` conditions on grants. Requires authGroups. Do not enable on a fleet \`preflight:auth\` reports as crossing a reducer version.",
              "type": "boolean",
            },
            "authEnforcement": {
              "default": false,
              "description": "Enforce the auth scope's policy at admission, replay, and read. Requires documentDecisions.",
              "type": "boolean",
            },
            "authGroups": {
              "default": false,
              "description": "Let \`{ group }\` principals match against the rosters of the group documents a policy names. Requires authEnforcement.",
              "type": "boolean",
            },
            "documentDecisions": {
              "default": false,
              "description": "Decide writes from the document stream rather than the document meta cache, so a backdated deletion denies the operations that sort after it.",
              "type": "boolean",
            },
          },
          "type": "object",
        },
        "unsupportedStoredDocuments": {
          "default": "refuse",
          "description": "What the reactor does when this browser's store holds documents at protocol versions this build does not run. \`refuse\` fails the boot and names the versions; \`read-only\` boots and keeps those documents read-only.",
          "enum": [
            "refuse",
            "read-only",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "renown": {
      "additionalProperties": false,
      "description": "Renown identity / authentication coordinates.",
      "properties": {
        "adapters": {
          "additionalProperties": false,
          "description": "Per-adapter wallet config for in-page auth. Presence of an adapter key enables it; omit or leave empty for redirect-only behaviour.",
          "properties": {
            "privy": {
              "additionalProperties": false,
              "description": "Privy embedded/social adapter config.",
              "properties": {
                "appId": {
                  "description": "Privy application id; required for this adapter to function.",
                  "type": "string",
                },
                "clientId": {
                  "description": "Optional Privy client id.",
                  "type": "string",
                },
                "methods": {
                  "description": "Login methods this adapter offers; default per adapter when omitted.",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
            "rainbow": {
              "additionalProperties": false,
              "description": "wagmi + RainbowKit external-wallet adapter config.",
              "properties": {
                "infuraProjectId": {
                  "description": "Optional Infura project id used to build RPC transports.",
                  "type": "string",
                },
                "walletConnectProjectId": {
                  "description": "WalletConnect project id; required for this adapter to function.",
                  "type": "string",
                },
              },
              "type": "object",
            },
          },
          "type": "object",
        },
        "chainId": {
          "default": 1,
          "description": "CAIP-2 chain reference within the network namespace.",
          "type": "number",
        },
        "namespace": {
          "description": "Renown localStorage namespace; share it across Connects to share login.",
          "type": "string",
        },
        "networkId": {
          "default": "eip155",
          "description": "CAIP-2 network namespace (e.g. 'eip155').",
          "type": "string",
        },
        "switchboardUrl": {
          "description": "Switchboard GraphQL URL. When set, Connect enables in-page (no-redirect) Renown sign-in; otherwise it falls back to the redirect flow via \`url\`.",
          "type": "string",
        },
        "url": {
          "default": "https://www.renown.id",
          "description": "Renown auth service URL.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "sentry": {
      "additionalProperties": false,
      "description": "Sentry error-tracking coordinates. Set \`dsn\` to enable Sentry; leave \`dsn\` null to disable. The Sentry release tag stays build-time (stamped via Vite's \`define\` from WORKSPACE_VERSION) so it always matches the sourcemaps uploaded by CI.",
      "properties": {
        "dsn": {
          "default": null,
          "description": "Sentry DSN URL. \`null\` disables Sentry entirely; the SPA never loads the Sentry SDK chunk.",
          "type": [
            "string",
            "null",
          ],
        },
        "env": {
          "default": "dev",
          "description": "Sentry environment label, surfaced as the \`environment\` tag on every event.",
          "type": "string",
        },
        "tracing": {
          "default": false,
          "description": "Enable Sentry performance tracing.",
          "type": "boolean",
        },
      },
      "type": "object",
    },
  },
  "type": "object",
}
`;
