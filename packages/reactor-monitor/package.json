{
  "name": "@powerhousedao/reactor-monitor",
  "version": "6.2.3-dev.40",
  "description": "Reactor provisioning and inspection APIs for the reactor-monitor lab bench (multi-reactor initiative, stage 0).",
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "module",
