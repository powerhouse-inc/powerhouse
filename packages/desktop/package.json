{
  "name": "@powerhousedao/desktop",
  "version": "6.2.3-dev.91",
  "description": "The desktop runner for uniform-runners hosts: the generic compound stack wrapped in a native shell — dev opens the window, build stages the shippable stack.",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-inc/powerhouse",
    "directory": "packages/desktop"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./runner": {
      "source": "./src/runner.ts",
      "types": "./dist/runner.d.mts",
      "import": "./dist/runner.mjs",
      "default": "./dist/runner.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tsc": "tsc",
    "lint": "cd ../.. && oxlint packages/desktop",
    "build": "tsdown",
    "test": "vitest --run",
    "emit-schemas": "tsx scripts/emit-schemas.ts"
  },
  "dependencies": {
    "@powerhousedao/host-core": "workspace:*",
    "@powerhousedao/shared": "workspace:*",
    "@renown/sdk": "workspace:*",
    "rolldown": "catalog:",
    "viem": "~2.50.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
