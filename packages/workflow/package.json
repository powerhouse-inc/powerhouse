{
  "name": "@powerhousedao/workflow",
  "version": "6.2.3-dev.26",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/runtime-piece-source.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-inc/powerhouse",
    "directory": "packages/workflow"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.mjs"
    },
    "./reactor": {
      "source": "./reactor/index.ts",
      "types": "./dist/types/reactor/index.d.ts",
      "browser": "./dist/browser/reactor/index.js"
    },
    "./document-models": {
      "source": "./document-models/index.ts",
      "types": "./dist/types/document-models/index.d.ts",
      "browser": "./dist/browser/document-models/index.js",
      "node": "./dist/node/document-models/index.mjs"
    },
    "./document-models/*": {
      "source": "./document-models/*/index.ts",
      "types": "./dist/types/document-models/*/index.d.ts",
      "browser": "./dist/browser/document-models/*/index.js",
      "node": "./dist/node/document-models/*/index.mjs"
    },
    "./editors": {
      "source": "./editors/index.ts",
      "types": "./dist/types/editors/index.d.ts",
      "browser": "./dist/browser/editors/index.js",
      "node": "./dist/node/editors/index.mjs"
    },
    "./pieces": {
      "source": "./pieces/index.ts",
      "types": "./dist/types/pieces/index.d.ts",
      "node": "./dist/node/pieces/index.mjs"
    },
    "./pieces/*": {
      "source": "./pieces/*/index.ts",
      "types": "./dist/types/pieces/*/index.d.ts",
      "node": "./dist/node/pieces/*/index.mjs"
    },
    "./manifest": "./dist/powerhouse.manifest.json",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tsc": "tsc",
    "lint": "cd ../.. && oxlint packages/workflow",
    "test": "vitest --run",
    "test:watch": "vitest",
    "build": "tsx ./build.ts",
    "ui:shots": "tsx ./scripts/ui-shots.ts",
    "ui:serve": "tsx ./scripts/ui-shots.ts --serve",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@powerhousedao/design-system": "workspace:*",
    "@powerhousedao/pieces-framework": "workspace:*",
    "@powerhousedao/reactor": "workspace:*",
    "@powerhousedao/reactor-browser": "workspace:*",
    "@powerhousedao/shared": "workspace:*",
    "@uiw/react-json-view": "2.0.0-alpha.42",
    "@xyflow/react": "12.11.6",
    "document-model": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@powerhousedao/powerhouse-vetra-packages": "workspace:*",
    "@tailwindcss/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "rolldown": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Powerhouse workflows in Connect: the workflow and connection document models, their editors and Workflow Studio, the assistant tools and the reactor piece.",
  "keywords": [
    "powerhouse",
    "workflow",
    "automation",
    "document-model",
    "connect",
    "pieces",
    "activepieces"
  ]
}
