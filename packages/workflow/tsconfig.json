{
  "extends": "../../tsconfig.options.json",
  "compilerOptions": {
    "outDir": "./.tsbuild",
    "declarationDir": "./dist/types",
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ESNext", "dom", "dom.iterable"],
    "paths": {
      "document-models": ["./document-models/index.ts"],
      "document-models/*": ["./document-models/*/index.ts"],
      "editors": ["./editors/index.ts"],
      "editors/*": ["./editors/*/index.ts"]
    }
  },
  "include": ["**/*", "./powerhouse.manifest.json"],
  "exclude": ["dist", "node_modules", ".ph"],
  "references": [
    {
      "path": "../design-system"
    },
    {
      "path": "../document-model"
    },
    {
      "path": "../pieces-framework"
    },
    {
      "path": "../powerhouse-vetra-packages"
    },
    {
      "path": "../reactor"
    },
    {
      "path": "../reactor-browser"
    },
    {
      "path": "../shared"
    }
  ]
}
