{
  "name": "@powerhousedao/reactor-workflow",
  "version": "6.2.3-dev.21",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/powerhouse-inc/powerhouse",
    "directory": "packages/reactor-workflow"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tsc": "tsc",
    "lint": "eslint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "build": "tsdown"
  },
  "dependencies": {
    "@powerhousedao/pieces-framework": "workspace:*",
    "@powerhousedao/reactor": "workspace:*",
    "@powerhousedao/shared": "workspace:*",
    "@powerhousedao/workflow": "workspace:*",
    "croner": "10.0.1",
    "document-model": "workspace:*",
    "graphql": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "kysely": "catalog:",
    "kysely-pglite-dialect": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "description": "The Powerhouse workflow engine: the reactor-side runtime that runs workflow documents, and the piece loader, worker pool and executor beneath it.",
  "keywords": [
    "powerhouse",
    "workflow",
    "automation",
    "reactor",
    "pieces",
    "activepieces"
  ]
}
