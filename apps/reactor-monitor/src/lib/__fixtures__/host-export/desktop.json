{
  "format": "ph-host-export",
  "version": 1,
  "project": {
    "name": "my-project",
    "root": "/project"
  },
  "name": "desktop",
  "host": {
    "name": "desktop",
    "runner": {
      "module": "@powerhousedao/desktop/runner"
    },
    "profile": {
      "appId": "inc.powerhouse.desktop.my-project",
      "name": "my-project Desktop"
    },
    "config": {
      "startOrder": ["desktop-switchboard", "desktop-connect"],
      "cspRegistrySync": true,
      "runtimeRecord": true
    },
    "children": {
      "desktop-switchboard": {
        "host": "switchboard",
        "reactor": {
          "protocol": {
            "featureFlags": {
              "documentDecisions": false,
              "authEnforcement": false,
              "authGroups": false,
              "authConditions": false
            },
            "createSignaturePolicy": "v2-required",
            "unsupportedStoredDocuments": "refuse"
          },
          "backends": {
            "main": {
              "kind": "in-process",
              "storage": {
                "kind": "path",
                "dataDir": "${userData}/.ph/reactor-storage"
              },
              "packages": {
                "dynamic": true
              }
            }
          },
          "drives": [
            {
              "slug": "powerhouse",
              "name": "my-project"
            }
          ]
        }
      },
      "desktop-connect": {
        "host": "connect",
        "runner": {
          "defaultVerb": "serve",
          "port": 6491,
          "plugins": [
            {
              "module": "@powerhousedao/connect/plugins/generic",
              "config": {
                "allowAddDrive": true,
                "sections": {
                  "remote": {
                    "enabled": true,
                    "allowAdd": true,
                    "allowDelete": true
                  },
                  "local": {
                    "enabled": true,
                    "allowAdd": true,
                    "allowDelete": true
                  }
                },
                "icons": null,
                "homeBackground": null
              }
            },
            {
              "module": "@powerhousedao/connect/plugins/workflows",
              "config": {
                "drive": {
                  "$output": {
                    "host": "switchboard",
                    "path": ["drives", "workflows", "url"]
                  }
                }
              }
            }
          ]
        },
        "reactor": {
          "protocol": {
            "featureFlags": {
              "documentDecisions": false,
              "authEnforcement": false,
              "authGroups": false,
              "authConditions": false
            },
            "createSignaturePolicy": "v2-required",
            "unsupportedStoredDocuments": "refuse"
          },
          "backends": {
            "main": {
              "kind": "worker"
            }
          },
          "drives": {
            "$map": {
              "over": {
                "$output": {
                  "host": "switchboard",
                  "path": ["drives"]
                }
              },
              "to": {
                "slug": {
                  "$key": true
                },
                "remote": {
                  "url": {
                    "$item": ["url"]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "members": {
    "switchboard": {
      "name": "my-project-switchboard",
      "runner": {
        "module": "@powerhousedao/ph-cli/runners/switchboard",
        "port": 7491,
        "plugins": [
          "@powerhousedao/switchboard/plugins/mcp",
          "@powerhousedao/switchboard/plugins/attachments",
          "@powerhousedao/switchboard/plugins/workflows"
        ]
      },
      "reactor": {
        "protocol": {
          "featureFlags": {
            "documentDecisions": false,
            "authEnforcement": false,
            "authGroups": false,
            "authConditions": false
          },
          "createSignaturePolicy": "v2-required",
          "unsupportedStoredDocuments": "refuse"
        },
        "drives": [
          {
            "slug": "powerhouse",
            "name": "my-project"
          }
        ]
      }
    },
    "connect": {
      "name": "my-project-connect",
      "runner": {
        "module": "@powerhousedao/ph-cli/runners/connect",
        "port": 6491,
        "plugins": [
          {
            "module": "@powerhousedao/connect/plugins/generic",
            "config": {
              "allowAddDrive": true,
              "sections": {
                "remote": {
                  "enabled": true,
                  "allowAdd": true,
                  "allowDelete": true
                },
                "local": {
                  "enabled": true,
                  "allowAdd": true,
                  "allowDelete": true
                }
              },
              "icons": null,
              "homeBackground": null
            }
          }
        ]
      },
      "config": {
        "branding": {
          "appName": "Powerhouse Connect",
          "icon": null,
          "loader": null
        },
        "home": {
          "background": null
        },
        "app": {
          "logLevel": "info",
          "basePath": "/",
          "offline": true,
          "studioMode": false
        },
        "ai": {
          "assistantEnabled": false
        },
        "packages": {
          "externalEnabled": true,
          "liveReload": false
        },
        "drives": {
          "allowAddDrive": true,
          "defaultDrives": [],
          "sections": {
            "remote": {
              "enabled": true,
              "allowAdd": true,
              "allowDelete": true
            },
            "local": {
              "enabled": true,
              "allowAdd": true,
              "allowDelete": true
            }
          },
          "icons": null
        },
        "renown": {
          "url": "https://www.renown.id",
          "networkId": "eip155",
          "chainId": 1
        },
        "sentry": {
          "dsn": null,
          "env": "dev",
          "tracing": false
        },
        "openPanel": {
          "clientId": "",
          "trackUiEvents": true,
          "trackOperations": true
        },
        "instance": {
          "namespace": null,
          "reactorWorker": false,
          "multiReactor": false
        },
        "reactor": {
          "featureFlags": {
            "documentDecisions": false,
            "authEnforcement": false,
            "authGroups": false,
            "authConditions": false
          },
          "createSignaturePolicy": "v2-required",
          "unsupportedStoredDocuments": "refuse"
        }
      },
      "profile": {
        "appId": "inc.powerhouse.connect.my-project",
        "name": "my-project"
      },
      "reactor": {
        "protocol": {
          "featureFlags": {
            "documentDecisions": false,
            "authEnforcement": false,
            "authGroups": false,
            "authConditions": false
          },
          "createSignaturePolicy": "v2-required",
          "unsupportedStoredDocuments": "refuse"
        },
        "backends": {
          "main": {
            "kind": "worker"
          }
        },
        "drives": [
          {
            "slug": "powerhouse",
            "name": "my-project"
          }
        ]
      }
    }
  }
}
