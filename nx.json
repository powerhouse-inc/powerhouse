{
  "namedInputs": {
    "noMarkdown": ["!{projectRoot}/**/*.md"],
    "noStories": [
      "!{projectRoot}/**/*.stories.tsx",
      "!{projectRoot}/.storybook/**/*"
    ],
    "noLicenses": ["!{projectRoot}/LICENSE", "!{projectRoot}/LICENSE.md"],
    "noTests": [
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/coverage/**/*",
      "!{projectRoot}/test/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.json"
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/.tsbuild/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "noMarkdown",
      "noStories",
      "noLicenses",
      "noTests"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production", { "env": "PH_PACKAGES" }],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/.tsbuild",
        "{projectRoot}/COMMANDS.md"
      ]
    }
  },
  "release": {
    "projects": [
      "packages/*",
      "packages/analytics-engine/*",
      "clis/*",
      "apps/*"
    ],
    "projectsRelationship": "managed",
    "version": {
      "conventionalCommits": true,
      "updateDependents": "auto",
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github"
      }
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  }
}
