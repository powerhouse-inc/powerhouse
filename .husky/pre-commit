#!/usr/bin/env bash

# Format and lint staged files before anything else looks at them.
pnpm exec lint-staged

ACADEMY_DIR="apps/academy"

# Inputs that trigger regeneration
CLI_MONITORED_FILES="clis/ph-cmd/COMMANDS.md clis/ph-cli/COMMANDS.md"

# Generated outputs, repo-root-relative. Must match what the generator writes.
CLI_DOC_OUTPUTS="apps/academy/docs/academy/04-Reference/07-CLITooling/00-PowerhouseCLI.md"

# Run an academy generator with the root tsx (they only use node builtins, so the
# academy's own install isn't needed); abort the commit if it fails.
run_generator() {
  echo "Running $ACADEMY_DIR/scripts/$1..."
  pnpm exec tsx "$ACADEMY_DIR/scripts/$1" || {
    echo "$1 failed. Aborting commit."
    exit 1
  }
}

# Stage each generated file that the generator actually changed.
stage_generated() {
  staged_any=false
  for output in $1; do
    if [ -n "$(git status --porcelain -- "$output")" ]; then
      git add -- "$output" || exit 1
      echo "  staged $output"
      staged_any=true
    fi
  done
  if [ "$staged_any" = false ]; then
    echo "  already up to date"
  fi
}

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

should_run_cli_docs_generation=false
for monitored_file in $CLI_MONITORED_FILES; do
  if echo "$STAGED_FILES" | grep -q "^$monitored_file$"; then
    should_run_cli_docs_generation=true
    break
  fi
done

if [ "$should_run_cli_docs_generation" = true ]; then
  echo "Relevant CLI COMMANDS.md file changed. Generating Academy CLI documentation..."
  run_generator generate-combined-cli-docs.ts
  stage_generated "$CLI_DOC_OUTPUTS"
else
  echo "No relevant CLI COMMANDS.md changes detected. Skipping CLI documentation generation."
fi

# Add any other root-level pre-commit checks below if needed

exit 0
