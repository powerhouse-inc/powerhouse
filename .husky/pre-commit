#!/usr/bin/env bash

# Format and lint staged files before anything else looks at them.
pnpm exec lint-staged

ACADEMY_DIR="apps/academy"

# Inputs that trigger regeneration
CLI_MONITORED_FILES="clis/ph-cmd/COMMANDS.md clis/ph-cli/COMMANDS.md"
LLM_MONITORED_PATTERN="^apps/academy/docs/.*\.md$"

# Generated outputs, repo-root-relative. Must match what the generators write.
CLI_DOC_OUTPUTS="apps/academy/docs/academy/04-Reference/07-CLITooling/00-PowerhouseCLI.md"
# The legacy academy_LLM_docs.md pair is gitignored, so it is not listed here.
LLM_DOC_OUTPUTS="apps/academy/llms.txt
apps/academy/llms-full.txt
apps/academy/static/llms.txt
apps/academy/static/llms-full.txt"

# Run a generator from inside apps/academy; abort the commit if it fails.
run_generator() {
  echo "Running 'pnpm $1' in $ACADEMY_DIR..."
  (cd "$ACADEMY_DIR" && pnpm "$1") || {
    echo "'pnpm $1' failed. Aborting commit."
    exit 1
  }
}

# Stage each generated file that the generator actually changed.
# Sets STAGED_GENERATED to the files it staged.
stage_generated() {
  STAGED_GENERATED=""
  for output in $1; do
    if [ -n "$(git status --porcelain -- "$output")" ]; then
      git add -- "$output" || exit 1
      echo "  staged $output"
      STAGED_GENERATED="$STAGED_GENERATED$output
"
    fi
  done
  if [ -z "$STAGED_GENERATED" ]; then
    echo "  already up to date"
  fi
}

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

should_run_cli_docs_generation=false
for monitored_file in $CLI_MONITORED_FILES; do
  if echo "$STAGED_FILES" | grep -q "^$monitored_file$"; then
    should_run_cli_docs_generation=true
    break
  fi
done

should_run_llm_docs_generation=false
if echo "$STAGED_FILES" | grep -qE "$LLM_MONITORED_PATTERN"; then
  should_run_llm_docs_generation=true
fi

if [ "$should_run_cli_docs_generation" = true ]; then
  echo "Relevant CLI COMMANDS.md file changed. Generating Academy CLI documentation..."
  run_generator generate:cli-docs
  stage_generated "$CLI_DOC_OUTPUTS"

  # Regenerated CLI docs are themselves academy markdown, so the LLM docs are
  # now stale too.
  if [ -n "$STAGED_GENERATED" ]; then
    should_run_llm_docs_generation=true
  fi
else
  echo "No relevant CLI COMMANDS.md changes detected. Skipping CLI documentation generation."
fi

if [ "$should_run_llm_docs_generation" = true ]; then
  echo "Academy markdown files changed. Regenerating LLM-optimized documentation..."
  run_generator generate:llm-docs
  stage_generated "$LLM_DOC_OUTPUTS"
else
  echo "No academy markdown changes detected. Skipping LLM documentation generation."
fi

# Add any other root-level pre-commit checks below if needed

exit 0
